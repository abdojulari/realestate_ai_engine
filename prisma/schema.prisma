generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int               @id @default(autoincrement())
  email                String            @unique
  password             String?
  firstName            String
  lastName             String
  phone                String?
  preferredContactTime String?
  role                 String            @default("user")
  provider             String?
  providerId           String?
  avatar               String?
  bio                  String?
  timezone             String?           @default("America/New_York")
  language             String?           @default("English")
  emailNotifications   Boolean           @default(true)
  pushNotifications    Boolean           @default(true)
  smsNotifications     Boolean           @default(false)
  twoFactorEnabled     Boolean           @default(false)
  twoFactorSecret      String?
  twoFactorCode        String?
  twoFactorCodeExpiry  DateTime?
  lastLoginAt          DateTime?
  loginCount           Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  consentDate          DateTime?
  consentIpAddress     String?
  marketingConsent     Boolean           @default(false)
  homeEstimates        HomeEstimate[]
  properties           Property[]
  propertyAlerts       PropertyAlert[]
  inquiries            PropertyInquiry[]
  propertyViews        PropertyView[]
  savedProperties      SavedProperty[]
  savedSearches        SavedSearch[]
  viewingRequests      ViewingRequest[]
  activityLogs         ActivityLog[]
  documents            Document[]
  signatures           Signature[]
}

model Property {
  id                     Int                   @id @default(autoincrement())
  title                  String
  description            String
  price                  Float
  beds                   Int
  baths                  Float
  sqft                   Float
  type                   String
  status                 String
  address                String
  city                   String
  province               String
  postalCode             String
  latitude               Float?
  longitude              Float?
  features               Json?
  images                 Json
  userId                 Int?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  views                  Int                   @default(0)
  cityRegion             String?
  externalId             String?
  lastSyncAt             DateTime?
  lotSizeArea            Float?
  lotSizeDimensions      String?
  lotSizeUnits           String?
  mlsNumber              String?
  parcelNumber           String?
  propertyCondition      String?
  source                 String                @default("manual")
  stories                Int?
  streetName             String?
  streetNumber           String?
  taxAnnualAmount        Float?
  taxYear                Int?
  unitNumber             String?
  waterBodyName          String?
  yearBuilt              Int?
  zoning                 String?
  zoningDescription      String?
  coListingAgentsData    Json?
  coListingOfficesData   Json?
  listingAgentData       Json?
  listingOfficeData      Json?
  originalEntryTimestamp DateTime?             // From CREA OriginalEntryTimestamp
  daysOnMarket           Int?                  // Calculated: today - originalEntryTimestamp
  user                   User?                 @relation(fields: [userId], references: [id])
  inquiries              PropertyInquiry[]
  neighborhood           PropertyNeighborhood?
  propertyViews          PropertyView[]
  savedBy                SavedProperty[]
  viewingRequests        ViewingRequest[]

  @@unique([source, externalId])
}

model Neighborhood {
  id               Int                    @id @default(autoincrement())
  name             String
  city             String
  province         String
  country          String                 @default("Canada")
  centerLatitude   Float?
  centerLongitude  Float?
  boundingBox      Json?
  formattedAddress String?
  confidence       Int?
  components       Json?
  propertyCount    Int                    @default(0)
  averagePrice     Float?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  properties       PropertyNeighborhood[]

  @@unique([name, city, province])
  @@index([city, province])
}

model PropertyNeighborhood {
  id             Int          @id @default(autoincrement())
  propertyId     Int          @unique
  neighborhoodId Int
  confidence     Int?
  lastLookup     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  neighborhood   Neighborhood @relation(fields: [neighborhoodId], references: [id])
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([neighborhoodId])
}

model ContentBlock {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  title     String
  content   String
  type      String
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SavedSearch {
  id        Int      @id @default(autoincrement())
  userId    Int
  filters   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model PropertyAlert {
  id               Int       @id @default(autoincrement())
  userId           Int
  naturalQuery     String
  parsedFilters    Json
  city             String?
  frequency        String
  isActive         Boolean   @default(true)
  lastRun          DateTime?
  nextRun          DateTime?
  emailEnabled     Boolean   @default(true)
  pushEnabled      Boolean   @default(false)
  marketingConsent Boolean   @default(false)
  consentDate      DateTime?
  lastResults      Json?
  totalSent        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id])
}

model ViewingRequest {
  id         Int      @id @default(autoincrement())
  userId     Int
  propertyId Int
  dateTime   DateTime
  status     String
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  property   Property @relation(fields: [propertyId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PropertyInquiry {
  id         Int      @id @default(autoincrement())
  userId     Int?
  propertyId Int
  message    String
  status     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  property   Property @relation(fields: [propertyId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])
}

model SavedProperty {
  id         Int      @id @default(autoincrement())
  userId     Int
  propertyId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  property   Property @relation(fields: [propertyId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, propertyId])
}

model PropertyView {
  id         Int      @id @default(autoincrement())
  userId     Int?
  propertyId Int
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])
}

model EmailTemplate {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  subject   String
  content   String
  variables Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomeEstimate {
  id                Int      @id @default(autoincrement())
  userId            Int?
  address           String
  postalCode        String
  propertyType      String
  beds              Int
  baths             Float
  sqft              Float
  yearBuilt         Int
  lotSize           String
  condition         String
  features          Json?
  renovations       Json?
  additionalInfo    String?
  firstName         String
  lastName          String
  email             String
  phone             String
  timeframe         String
  contactPreference Boolean  @default(false)
  status            String   @default("pending")
  estimatedValue    Float?
  agentNotes        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User?    @relation(fields: [userId], references: [id])
}

model Testimonial {
  id           Int      @id @default(autoincrement())
  name         String
  email        String
  phone        String?
  location     String
  content      String
  rating       Int      @default(5)
  propertyType String?
  avatar       String?
  approved     Boolean  @default(false)
  featured     Boolean  @default(false)
  displayOrder Int?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([approved, featured, displayOrder])
  @@index([createdAt])
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  action      String
  entity      String?
  entityId    Int?
  description String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([action])
  @@index([entity, entityId])
}

model Document {
  id               Int       @id @default(autoincrement())
  userId           Int
  name             String
  originalName     String
  type             String
  fileSize         Int
  filePath         String
  status           String    @default("draft")
  isSigned         Boolean   @default(false)
  signatureData    Json?
  watermarkApplied Boolean   @default(false)
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}

model Signature {
  id          Int      @id @default(autoincrement())
  userId      Int
  name        String
  type        String
  signatureData String @db.Text
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NewsletterSubscriber {
  id                  Int                  @id @default(autoincrement())
  email               String               @unique
  firstName           String?
  lastName            String?
  status              String               @default("active") // active, unsubscribed, bounced
  source              String               @default("website") // website, manual, import
  tags                Json?
  metadata            Json?
  subscribedAt        DateTime             @default(now())
  unsubscribedAt      DateTime?
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sentNewsletters     SentNewsletter[]

  @@index([email, status])
  @@index([status, subscribedAt])
}

model NewsletterTemplate {
  id                  Int                  @id @default(autoincrement())
  name                String               @unique
  subject             String
  content             String               @db.Text
  plainTextContent    String?              @db.Text
  previewText         String?
  category            String?              // market-update, property-showcase, tips, announcement
  tags                Json?
  isActive            Boolean              @default(true)
  attachments         Json?                // Array of attachment metadata {name, path, type, size}
  variables           Json?                // Available template variables
  designSettings      Json?                // Styling, colors, fonts
  createdBy           Int?
  lastModifiedBy      Int?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  newsletters         Newsletter[]

  @@index([category, isActive])
}

model Newsletter {
  id                  Int                  @id @default(autoincrement())
  name                String
  templateId          Int?
  subject             String
  content             String               @db.Text
  plainTextContent    String?              @db.Text
  previewText         String?
  status              String               @default("draft") // draft, scheduled, sending, sent, cancelled
  frequency           String?              // once, daily, weekly, monthly
  scheduledFor        DateTime?
  sentAt              DateTime?
  recipientCount      Int                  @default(0)
  openCount           Int                  @default(0)
  clickCount          Int                  @default(0)
  bounceCount         Int                  @default(0)
  unsubscribeCount    Int                  @default(0)
  attachments         Json?                // Array of attachment metadata
  tags                Json?
  targetFilters       Json?                // Filters for recipient targeting
  abTestConfig        Json?                // A/B testing configuration
  automationSettings  Json?                // Automation rules and triggers
  createdBy           Int?
  lastModifiedBy      Int?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  template            NewsletterTemplate?  @relation(fields: [templateId], references: [id])
  sentNewsletters     SentNewsletter[]

  @@index([status, scheduledFor])
  @@index([frequency, status])
  @@index([createdAt])
}

model SentNewsletter {
  id                  Int                     @id @default(autoincrement())
  newsletterId        Int
  subscriberId        Int
  status              String                  @default("sent") // sent, opened, clicked, bounced, failed
  sentAt              DateTime                @default(now())
  openedAt            DateTime?
  clickedAt           DateTime?
  bouncedAt           DateTime?
  bounceReason        String?
  unsubscribedAt      DateTime?
  ipAddress           String?
  userAgent           String?
  metadata            Json?                   // tracking data, errors, etc
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  newsletter          Newsletter              @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  subscriber          NewsletterSubscriber    @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([newsletterId, status])
  @@index([subscriberId])
  @@index([sentAt])
}

model NewsletterAutomation {
  id                  Int                  @id @default(autoincrement())
  name                String
  description         String?
  triggerType         String               // time-based, event-based
  frequency           String?              // daily, weekly, monthly (for time-based)
  dayOfWeek           Int?                 // 0-6 for weekly
  dayOfMonth          Int?                 // 1-31 for monthly
  timeOfDay           String?              // HH:MM format
  timezone            String               @default("America/New_York")
  templateId          Int?
  subject             String?
  targetFilters       Json?                // Recipient filtering rules
  isActive            Boolean              @default(true)
  lastRun             DateTime?
  nextRun             DateTime?
  runCount            Int                  @default(0)
  createdBy           Int?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([isActive, nextRun])
  @@index([triggerType, frequency])
}
