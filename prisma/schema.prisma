  adminId         Int?
  admin           User?         @relation("TenantPosts", fields: [adminId], references: [id])
  title           String
  slug            String
  excerpt         String?       @db.Text
  content         String        @db.Text
  contentHtml     String?       @db.Text
  coverImage      String?
  coverImageAlt   String?
  authorId        Int?
  categoryId      Int?
  tags            Json?
  status          String        @default("draft")
  publishedAt     DateTime?
