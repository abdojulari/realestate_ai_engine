  /**
   * Filename only; files live under storage/marketing-resources (not web-public).
   */
  storageKey       String
  originalFileName String
  mimeType         String
  fileSize         Int
  published        Boolean  @default(false)
  thankYouMessage  String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  downloadLeads ResourceDownloadLead[]

  @@index([adminId])
  @@index([adminId, published])
}

model ResourceDownloadLead {
  id         Int               @id @default(autoincrement())
