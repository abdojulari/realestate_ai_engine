generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
// USER & AUTH
// ═══════════════════════════════════════════════════════════════

model User {
  id                   Int               @id @default(autoincrement())
  email                String            @unique
  password             String?
  firstName            String
  lastName             String
  phone                String?
  preferredContactTime String?
  role                 String            @default("user") // super_admin, admin, user
  provider             String?
  providerId           String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  consentDate          DateTime?
  consentIpAddress     String?
  marketingConsent     Boolean           @default(false)
  avatar               String?
  bio                  String?
  emailNotifications   Boolean           @default(true)
  language             String?           @default("English")
  lastLoginAt          DateTime?
  loginCount           Int               @default(0)
  pushNotifications    Boolean           @default(true)
  smsNotifications     Boolean           @default(false)
  timezone             String?           @default("America/New_York")
  twoFactorCode        String?
  twoFactorCodeExpiry  DateTime?
  twoFactorEnabled     Boolean           @default(false)
  twoFactorSecret      String?

  // Subscription tier for admins (basic, silver, gold, platinum)
  subscriptionTier     String?

  // Admin relationship – users belong to an admin (tenant)
  adminId              Int?
  admin                User?             @relation("AdminUsers", fields: [adminId], references: [id])
  users                User[]            @relation("AdminUsers")

  // ── Personal-data relations (userId / authorId) ──
  activityLogs         ActivityLog[]
  documents            Document[]
  homeEstimates        HomeEstimate[]    @relation("UserEstimates")
  properties           Property[]        @relation("UserProperties")
  propertyAlerts       PropertyAlert[]
  inquiries            PropertyInquiry[] @relation("UserInquiries")
  propertyViews        PropertyView[]
  savedProperties      SavedProperty[]
  savedSearches        SavedSearch[]
  signatures           Signature[]
  viewingRequests      ViewingRequest[]
  blogPosts            BlogPost[]        @relation("AuthorPosts")

  // ── Tenant-owned data relations (adminId) ──
  // Records belonging to this admin's tenant
  tenantProperties         Property[]             @relation("TenantProperties")
  tenantContentBlocks      ContentBlock[]
  tenantSettingsRows       Setting[]              @relation("TenantSettingRows")
  tenantEmailTemplates     EmailTemplate[]
  tenantTestimonials       Testimonial[]
  tenantSubscribers        NewsletterSubscriber[]
  tenantNewsTemplates      NewsletterTemplate[]
  tenantNewsletters        Newsletter[]
  tenantAutomations        NewsletterAutomation[]
  tenantBlogCategories     BlogCategory[]
  tenantBlogTags           BlogTag[]
  tenantBlogPosts          BlogPost[]             @relation("TenantPosts")
  tenantChatLeads          ChatLead[]
  tenantEstimates          HomeEstimate[]         @relation("TenantEstimates")
  tenantInquiries          PropertyInquiry[]      @relation("TenantInquiries")
  tenantSiteSettings       TenantSettings?

  // ── New feature relations (tenant-scoped) ──
  tenantListingTemplates   ListingTemplate[]        @relation("TenantListingTemplates")
  tenantCrmClients         CrmClient[]              @relation("TenantCrmClients")
  tenantCrmTransactions    CrmTransaction[]         @relation("TenantCrmTransactions")
  tenantCalendarEvents     CalendarEvent[]          @relation("TenantCalendarEvents")
  tenantBookingSlots       BookingSlot[]            @relation("TenantBookingSlots")
  tenantBookings           Booking[]                @relation("TenantBookings")
  tenantFacebookIntegration FacebookIntegration?    @relation("TenantFacebookIntegration")
  tenantFacebookPosts      FacebookPost[]           @relation("TenantFacebookPosts")
  tenantPriceCutSearches   PriceCutSearch[]         @relation("TenantPriceCutSearches")

  // ── Bookkeeping relations (tenant-scoped) ──
  tenantBkExpenses         BkExpense[]              @relation("TenantBkExpenses")
  tenantBkRevenues         BkRevenue[]              @relation("TenantBkRevenues")
  tenantBkEmployees        BkEmployee[]             @relation("TenantBkEmployees")
  tenantBkPayrollPayments  BkPayrollPayment[]       @relation("TenantBkPayrollPayments")

  @@index([adminId])
}

// ═══════════════════════════════════════════════════════════════
// TENANT SETTINGS – per-admin branding, contact, social, etc.
// ═══════════════════════════════════════════════════════════════

model TenantSettings {
  id               Int      @id @default(autoincrement())
  adminId          Int      @unique
  admin            User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  // Branding
  businessName     String?          // "Alberta One Real Estate"
  tagline          String?          // Displayed under logo
  logoUrl          String?
  faviconUrl       String?
  primaryColor     String?          @default("#1976D2")

  // Contact
  phone            String?
  email            String?
  address          String?
  city             String?
  province         String?
  postalCode       String?

  // Social links  [{icon,name,url}]
  socialLinks      Json?

  // Brokerage
  brokerageName    String?
  brokerageLogoUrl String?

  // Footer / legal
  footerDisclaimer String?          @db.Text
  copyrightName    String?
  developerName    String?
  developerUrl     String?

  // Domain mapping (multi-tenant routing)
  subdomain        String?          @unique   // acme → acme.realestatehub.ca
  customDomain     String?          @unique   // acmesrealty.com

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

// ═══════════════════════════════════════════════════════════════
// PROPERTY & NEIGHBOURHOOD (tenant-scoped)
// ═══════════════════════════════════════════════════════════════

model Property {
  id                     Int                   @id @default(autoincrement())
  adminId                Int?
  admin                  User?                 @relation("TenantProperties", fields: [adminId], references: [id])
  title                  String
  description            String
  price                  Float
  beds                   Int
  baths                  Float
  sqft                   Float
  type                   String
  status                 String
  address                String
  city                   String
  province               String
  postalCode             String
  latitude               Float?
  longitude              Float?
  features               Json?
  images                 Json
  userId                 Int?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  views                  Int                   @default(0)
  cityRegion             String?
  externalId             String?
  lastSyncAt             DateTime?
  lotSizeArea            Float?
  lotSizeDimensions      String?
  lotSizeUnits           String?
  mlsNumber              String?
  parcelNumber           String?
  propertyCondition      String?
  source                 String                @default("manual")
  stories                Int?
  streetName             String?
  streetNumber           String?
  taxAnnualAmount        Float?
  taxYear                Int?
  unitNumber             String?
  waterBodyName          String?
  yearBuilt              Int?
  zoning                 String?
  zoningDescription      String?
  coListingAgentsData    Json?
  coListingOfficesData   Json?
  listingAgentData       Json?
  listingOfficeData      Json?
  daysOnMarket           Int?
  originalEntryTimestamp DateTime?
  firstEntryPrice        Float?                // Price when first synced – never updated after creation
  user                   User?                 @relation("UserProperties", fields: [userId], references: [id])
  inquiries              PropertyInquiry[]
  neighborhood           PropertyNeighborhood?
  propertyViews          PropertyView[]
  savedBy                SavedProperty[]
  viewingRequests        ViewingRequest[]
  priceHistory           PropertyPriceHistory[]

  @@unique([source, externalId])
  @@index([adminId])
}

// Neighbourhood = shared geographic reference data (global)
model Neighborhood {
  id               Int                    @id @default(autoincrement())
  name             String
  city             String
  province         String
  country          String                 @default("Canada")
  centerLatitude   Float?
  centerLongitude  Float?
  boundingBox      Json?
  formattedAddress String?
  confidence       Int?
  components       Json?
  propertyCount    Int                    @default(0)
  averagePrice     Float?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  properties       PropertyNeighborhood[]

  @@unique([name, city, province])
  @@index([city, province])
}

model PropertyNeighborhood {
  id             Int          @id @default(autoincrement())
  propertyId     Int          @unique
  neighborhoodId Int
  confidence     Int?
  lastLookup     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  neighborhood   Neighborhood @relation(fields: [neighborhoodId], references: [id])
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([neighborhoodId])
}

// ═══════════════════════════════════════════════════════════════
// CONTENT & SETTINGS (tenant-scoped)
// ═══════════════════════════════════════════════════════════════

model ContentBlock {
  id        Int      @id @default(autoincrement())
  adminId   Int?
  admin     User?    @relation(fields: [adminId], references: [id])
  key       String
  title     String
  content   String
  type      String
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminId, key])
  @@index([adminId])
}

model Setting {
  id        Int      @id @default(autoincrement())
  adminId   Int?
  admin     User?    @relation("TenantSettingRows", fields: [adminId], references: [id])
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminId, key])
  @@index([adminId])
}

// ═══════════════════════════════════════════════════════════════
// USER-SCOPED (personal data – userId only)
// ═══════════════════════════════════════════════════════════════

model SavedSearch {
  id        Int      @id @default(autoincrement())
  userId    Int
  filters   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model PropertyAlert {
  id               Int       @id @default(autoincrement())
  userId           Int
  naturalQuery     String
  parsedFilters    Json
  city             String?
  frequency        String
  isActive         Boolean   @default(true)
  lastRun          DateTime?
  nextRun          DateTime?
  emailEnabled     Boolean   @default(true)
  pushEnabled      Boolean   @default(false)
  marketingConsent Boolean   @default(false)
  consentDate      DateTime?
  lastResults      Json?
  totalSent        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id])
}

model ViewingRequest {
  id         Int      @id @default(autoincrement())
  userId     Int
  propertyId Int
  dateTime   DateTime
  status     String
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  property   Property @relation(fields: [propertyId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
}

model SavedProperty {
  id         Int      @id @default(autoincrement())
  userId     Int
  propertyId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  property   Property @relation(fields: [propertyId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, propertyId])
}

model PropertyView {
  id         Int      @id @default(autoincrement())
  userId     Int?
  propertyId Int
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])
}

// ═══════════════════════════════════════════════════════════════
// EMAIL & TEMPLATES (tenant-scoped)
// ═══════════════════════════════════════════════════════════════

model EmailTemplate {
  id        Int      @id @default(autoincrement())
  adminId   Int?
  admin     User?    @relation(fields: [adminId], references: [id])
  name      String
  subject   String
  content   String
  variables Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminId, name])
  @@index([adminId])
}

// ═══════════════════════════════════════════════════════════════
// CRM – LEADS, INQUIRIES, ESTIMATES (tenant-scoped)
// ═══════════════════════════════════════════════════════════════

model PropertyInquiry {
  id         Int      @id @default(autoincrement())
  adminId    Int?
  admin      User?    @relation("TenantInquiries", fields: [adminId], references: [id])
  userId     Int?
  propertyId Int
  message    String
  status     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  property   Property @relation(fields: [propertyId], references: [id])
  user       User?    @relation("UserInquiries", fields: [userId], references: [id])

  @@index([adminId])
}

model HomeEstimate {
  id                Int      @id @default(autoincrement())
  adminId           Int?
  admin             User?    @relation("TenantEstimates", fields: [adminId], references: [id])
  userId            Int?
  address           String
  postalCode        String
  propertyType      String
  beds              Int
  baths             Float
  sqft              Float
  yearBuilt         Int
  lotSize           String
  condition         String
  features          Json?
  renovations       Json?
  additionalInfo    String?
  firstName         String
  lastName          String
  email             String
  phone             String
  timeframe         String
  contactPreference Boolean  @default(false)
  status            String   @default("pending")
  estimatedValue    Float?
  agentNotes        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User?    @relation("UserEstimates", fields: [userId], references: [id])

  @@index([adminId])
}

model Testimonial {
  id           Int      @id @default(autoincrement())
  adminId      Int?
  admin        User?    @relation(fields: [adminId], references: [id])
  name         String
  email        String
  phone        String?
  location     String
  content      String
  rating       Int      @default(5)
  propertyType String?
  avatar       String?
  approved     Boolean  @default(false)
  featured     Boolean  @default(false)
  displayOrder Int?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([adminId, approved, featured, displayOrder])
  @@index([createdAt])
}

model ChatLead {
  id              Int      @id @default(autoincrement())
  adminId         Int?
  admin           User?    @relation(fields: [adminId], references: [id])
  name            String
  email           String
  phone           String?
  message         String?
  conversationLog Json?
  source          String   @default("chat_widget")
  status          String   @default("new")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([adminId, email])
  @@index([adminId, status])
}

// ═══════════════════════════════════════════════════════════════
// ACTIVITY LOG (user-scoped)
// ═══════════════════════════════════════════════════════════════

model ActivityLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  action      String
  entity      String?
  entityId    Int?
  description String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([action])
  @@index([entity, entityId])
}

// ═══════════════════════════════════════════════════════════════
// DOCUMENTS & SIGNATURES (user-scoped)
// ═══════════════════════════════════════════════════════════════

model Document {
  id               Int      @id @default(autoincrement())
  userId           Int
  name             String
  originalName     String
  type             String
  fileSize         Int
  filePath         String
  status           String   @default("draft")
  isSigned         Boolean  @default(false)
  signatureData    Json?
  watermarkApplied Boolean  @default(false)
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalReview      DocumentLegalReview?
  dateAlerts       DocumentDateAlert[]

  @@index([userId, createdAt])
  @@index([status])
}

model DocumentLegalReview {
  id                Int      @id @default(autoincrement())
  documentId        Int      @unique
  redFlags          Json
  importantNotes    Json
  importantDates    Json
  legalSummary      String   @db.Text
  buyerImpact       String   @db.Text
  sellerImpact      String   @db.Text
  partyRepresenting String?
  reviewedAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model DocumentDateAlert {
  id          Int       @id @default(autoincrement())
  documentId  Int
  label       String
  dueDate     DateTime
  daysBefore  Int       @default(2)
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([dueDate, sentAt])
}

model Signature {
  id            Int      @id @default(autoincrement())
  userId        Int
  name          String
  type          String
  signatureData String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════
// NEWSLETTER (tenant-scoped)
// ═══════════════════════════════════════════════════════════════

model NewsletterSubscriber {
  id              Int              @id @default(autoincrement())
  adminId         Int?
  admin           User?            @relation(fields: [adminId], references: [id])
  email           String
  firstName       String?
  lastName        String?
  status          String           @default("active")
  source          String           @default("website")
  tags            Json?
  metadata        Json?
  subscribedAt    DateTime         @default(now())
  unsubscribedAt  DateTime?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sentNewsletters SentNewsletter[]

  @@unique([adminId, email])
  @@index([adminId, status, subscribedAt])
}

model NewsletterTemplate {
  id               Int          @id @default(autoincrement())
  adminId          Int?
  admin            User?        @relation(fields: [adminId], references: [id])
  name             String
  subject          String
  content          String
  plainTextContent String?
  previewText      String?
  category         String?
  tags             Json?
  isActive         Boolean      @default(true)
  attachments      Json?
  variables        Json?
  designSettings   Json?
  createdBy        Int?
  lastModifiedBy   Int?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  newsletters      Newsletter[]

  @@unique([adminId, name])
  @@index([adminId, category, isActive])
}

model Newsletter {
  id                 Int                 @id @default(autoincrement())
  adminId            Int?
  admin              User?               @relation(fields: [adminId], references: [id])
  name               String
  templateId         Int?
  subject            String
  content            String
  plainTextContent   String?
  previewText        String?
  status             String              @default("draft")
  frequency          String?
  scheduledFor       DateTime?
  sentAt             DateTime?
  recipientCount     Int                 @default(0)
  openCount          Int                 @default(0)
  clickCount         Int                 @default(0)
  bounceCount        Int                 @default(0)
  unsubscribeCount   Int                 @default(0)
  attachments        Json?
  tags               Json?
  targetFilters      Json?
  abTestConfig       Json?
  automationSettings Json?
  createdBy          Int?
  lastModifiedBy     Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  template           NewsletterTemplate? @relation(fields: [templateId], references: [id])
  sentNewsletters    SentNewsletter[]

  @@index([adminId, status, scheduledFor])
  @@index([adminId, frequency, status])
  @@index([createdAt])
}

model SentNewsletter {
  id             Int                  @id @default(autoincrement())
  newsletterId   Int
  subscriberId   Int
  status         String               @default("sent")
  sentAt         DateTime             @default(now())
  openedAt       DateTime?
  clickedAt      DateTime?
  bouncedAt      DateTime?
  bounceReason   String?
  unsubscribedAt DateTime?
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  newsletter     Newsletter           @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  subscriber     NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([newsletterId, status])
  @@index([subscriberId])
  @@index([sentAt])
}

model NewsletterAutomation {
  id            Int       @id @default(autoincrement())
  adminId       Int?
  admin         User?     @relation(fields: [adminId], references: [id])
  name          String
  description   String?
  triggerType   String
  frequency     String?
  dayOfWeek     Int?
  dayOfMonth    Int?
  timeOfDay     String?
  timezone      String    @default("America/New_York")
  templateId    Int?
  subject       String?
  targetFilters Json?
  isActive      Boolean   @default(true)
  lastRun       DateTime?
  nextRun       DateTime?
  runCount      Int       @default(0)
  createdBy     Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([adminId, isActive, nextRun])
  @@index([triggerType, frequency])
}

// ═══════════════════════════════════════════════════════════════
// BLOG (tenant-scoped)
// ═══════════════════════════════════════════════════════════════

model BlogCategory {
  id          Int            @id @default(autoincrement())
  adminId     Int?
  admin       User?          @relation(fields: [adminId], references: [id])
  name        String
  slug        String
  description String?
  color       String?        @default("#1976D2")
  icon        String?        @default("mdi-folder")
  parentId    Int?
  sortOrder   Int            @default(0)
  isActive    Boolean        @default(true)
  postCount   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  parent      BlogCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    BlogCategory[] @relation("CategoryHierarchy")
  posts       BlogPost[]

  @@unique([adminId, name])
  @@unique([adminId, slug])
  @@index([adminId, isActive, sortOrder])
}

model BlogPost {
  id              Int           @id @default(autoincrement())
  adminId         Int?
  admin           User?         @relation("TenantPosts", fields: [adminId], references: [id])
  title           String
  slug            String
  excerpt         String?       @db.Text
  content         String        @db.Text
  contentHtml     String?       @db.Text
  coverImage      String?
  coverImageAlt   String?
  authorId        Int?
  categoryId      Int?
  tags            Json?
  status          String        @default("draft")
  publishedAt     DateTime?
  scheduledAt     DateTime?
  isFeatured      Boolean       @default(false)
  allowComments   Boolean       @default(true)
  views           Int           @default(0)
  readTime        Int?
  metaTitle       String?
  metaDescription String?       @db.Text
  metaKeywords    Json?
  canonicalUrl    String?
  ogImage         String?
  hashnodeId      String?
  hashnodeUrl     String?
  syncToHashnode  Boolean       @default(false)
  lastSyncedAt    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  author          User?         @relation("AuthorPosts", fields: [authorId], references: [id])
  category        BlogCategory? @relation(fields: [categoryId], references: [id])

  @@unique([adminId, slug])
  @@index([adminId, status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
  @@index([isFeatured, status])
  @@index([tags])
}

model BlogTag {
  id        Int      @id @default(autoincrement())
  adminId   Int?
  admin     User?    @relation(fields: [adminId], references: [id])
  name      String
  slug      String
  postCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminId, name])
  @@unique([adminId, slug])
  @@index([adminId])
}

// ═══════════════════════════════════════════════════════════════
// PROPERTY PRICE HISTORY (tenant-scoped via property)
// ═══════════════════════════════════════════════════════════════

model PropertyPriceHistory {
  id         Int      @id @default(autoincrement())
  propertyId Int
  price      Float
  event      String   // listed, price_increase, price_decrease, sold
  changeAmt  Float?   // dollar amount of change
  changePct  Float?   // percentage change
  source     String?  // crea, pillar9, manual
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, createdAt])
  @@index([event, createdAt])
}

// ═══════════════════════════════════════════════════════════════
// LISTING TEMPLATES (tenant-scoped)
// ═══════════════════════════════════════════════════════════════

model ListingTemplate {
  id              Int      @id @default(autoincrement())
  adminId         Int?
  admin           User?    @relation("TenantListingTemplates", fields: [adminId], references: [id])
  name            String
  propertyId      Int?
  propertyAddress String?
  description     String?  @db.Text
  aiDescription   String?  @db.Text
  theme           String   @default("luxury")   // luxury, modern, classic, minimal
  primaryColor    String?  @default("#1a1a2e")
  accentColor     String?  @default("#c9a96e")
  fontFamily      String?  @default("Playfair Display")
  images          Json?    // [{url, caption, type: 'hero'|'gallery'|'floorplan', order}]
  floorPlans      Json?    // [{url, label}]
  brandingLogo    String?
  features        Json?    // highlight features
  layout          String   @default("hero-gallery") // hero-gallery, slideshow, grid, split
  status          String   @default("draft")  // draft, published
  slug            String?
  views           Int      @default(0)
  createdBy       Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([adminId, slug])
  @@index([adminId, status])
}

// ═══════════════════════════════════════════════════════════════
// CRM – CLIENTS & TRANSACTIONS (tenant-scoped)
// ═══════════════════════════════════════════════════════════════

model CrmClient {
  id          Int      @id @default(autoincrement())
  adminId     Int?
  admin       User?    @relation("TenantCrmClients", fields: [adminId], references: [id])
  firstName   String
  lastName    String
  email       String?
  phone       String?
  type        String   // buyer, seller, investor, lead
  status      String   @default("active")  // active, inactive, closed
  source      String?  // inquiry, chat, estimate, referral, manual
  sourceId    Int?     // link to original lead record
  notes       String?  @db.Text
  tags        Json?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  transactions CrmTransaction[]

  @@unique([adminId, email])
  @@index([adminId, type, status])
}

model CrmTransaction {
  id            Int      @id @default(autoincrement())
  adminId       Int?
  admin         User?    @relation("TenantCrmTransactions", fields: [adminId], references: [id])
  clientId      Int
  client        CrmClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  propertyId    Int?
  type          String   // buying, selling
  status        String   @default("active")  // active, conditional, firm, closed, cancelled
  propertyAddress String?
  salePrice     Float?
  closingDate   DateTime?
  possessionDate DateTime?
  notes         String?  @db.Text
  progress      Float    @default(0) // 0-100 percentage
  currentStage  String?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  checklist     CrmChecklistItem[]

  @@index([adminId, status])
  @@index([clientId])
}

model CrmChecklistItem {
  id            Int       @id @default(autoincrement())
  transactionId Int
  transaction   CrmTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  label         String
  description   String?
  isCompleted   Boolean   @default(false)
  completedAt   DateTime?
  completedBy   Int?
  sortOrder     Int       @default(0)
  dueDate       DateTime?
  isRequired    Boolean   @default(true)
  category      String?   // pre-approval, showing, offer, conditions, closing
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([transactionId, sortOrder])
}

// ═══════════════════════════════════════════════════════════════
// CALENDAR & BOOKING (tenant-scoped)
// ═══════════════════════════════════════════════════════════════

model CalendarEvent {
  id          Int       @id @default(autoincrement())
  adminId     Int?
  admin       User?     @relation("TenantCalendarEvents", fields: [adminId], references: [id])
  title       String
  description String?   @db.Text
  type        String    // task, meeting, showing, open_house, reminder, personal
  startTime   DateTime
  endTime     DateTime?
  allDay      Boolean   @default(false)
  location    String?
  color       String?
  status      String    @default("scheduled") // scheduled, completed, cancelled
  priority    String?   @default("normal")    // low, normal, high, urgent
  reminders   Json?     // [{type: 'email'|'push', minutesBefore: 30}]
  recurrence  Json?     // {frequency, interval, endDate}
  propertyId  Int?
  clientId    Int?
  isPublic    Boolean   @default(false)
  metadata    Json?
  createdBy   Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([adminId, startTime, endTime])
  @@index([adminId, type, status])
}

model BookingSlot {
  id          Int       @id @default(autoincrement())
  adminId     Int?
  admin       User?     @relation("TenantBookingSlots", fields: [adminId], references: [id])
  dayOfWeek   Int?      // 0-6 (Sun-Sat), null for specific dates
  specificDate DateTime? // for one-off slots
  startTime   String    // HH:mm format
  endTime     String    // HH:mm format
  duration    Int       @default(30) // minutes per booking
  maxBookings Int       @default(1)
  isActive    Boolean   @default(true)
  propertyId  Int?      // if slot is property-specific
  label       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([adminId, dayOfWeek, isActive])
  @@index([adminId, specificDate])
}

model Booking {
  id          Int       @id @default(autoincrement())
  adminId     Int?
  admin       User?     @relation("TenantBookings", fields: [adminId], references: [id])
  slotId      Int?
  clientName  String
  clientEmail String
  clientPhone String?
  propertyId  Int?
  dateTime    DateTime
  endTime     DateTime?
  duration    Int       @default(30)
  status      String    @default("confirmed") // confirmed, cancelled, completed, no_show
  type        String    @default("showing")   // showing, consultation, open_house
  notes       String?   @db.Text
  confirmationSent Boolean @default(false)
  reminderSent     Boolean @default(false)
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([adminId, dateTime])
  @@index([adminId, status])
  @@index([clientEmail])
}

// ═══════════════════════════════════════════════════════════════
// FACEBOOK INTEGRATION (tenant-scoped)
// ═══════════════════════════════════════════════════════════════

model FacebookIntegration {
  id              Int       @id @default(autoincrement())
  adminId         Int       @unique
  admin           User      @relation("TenantFacebookIntegration", fields: [adminId], references: [id])
  accessToken     String?   @db.Text
  pageAccessToken String?   @db.Text
  pageId          String?
  pageName        String?
  userId          String?   // Facebook user ID
  userName        String?
  permissions     Json?     // granted permissions
  tokenExpiry     DateTime?
  isActive        Boolean   @default(true)
  adAccountId     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model FacebookPost {
  id          Int       @id @default(autoincrement())
  adminId     Int?
  admin       User?     @relation("TenantFacebookPosts", fields: [adminId], references: [id])
  propertyId  Int?
  postId      String?   // Facebook post ID
  content     String    @db.Text
  images      Json?     // image URLs posted
  link        String?
  status      String    @default("draft") // draft, scheduled, posted, failed
  scheduledFor DateTime?
  postedAt    DateTime?
  errorMessage String?
  engagement  Json?     // {likes, comments, shares}
  postType    String    @default("listing") // listing, campaign, custom
  metadata    Json?
  createdBy   Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([adminId, status])
  @@index([propertyId])
}

// ═══════════════════════════════════════════════════════════════
// SAVED PRICE CUT SEARCHES (tenant-scoped)
// ═══════════════════════════════════════════════════════════════

model PriceCutSearch {
  id         Int       @id @default(autoincrement())
  adminId    Int?
  admin      User?     @relation("TenantPriceCutSearches", fields: [adminId], references: [id])
  name       String
  filters    Json      // {city, community, area, propertyType, minDrop, maxPrice}
  resultCount Int      @default(0)
  lastRunAt  DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([adminId, isActive])
}

// ═══════════════════════════════════════════════════════════════
// BOOKKEEPING — Expenses (tenant-scoped, platinum only)
// ═══════════════════════════════════════════════════════════════

model BkExpense {
  id              Int       @id @default(autoincrement())
  adminId         Int?
  admin           User?     @relation("TenantBkExpenses", fields: [adminId], references: [id])
  vendor          String
  receiptNumber   String?
  date            DateTime
  subtotal        Float
  gstAmount       Float     @default(0)
  hstAmount       Float     @default(0)
  pstAmount       Float     @default(0)
  taxAmount       Float     @default(0)
  total           Float
  category        String    @default("general")
  description     String?
  receiptUrl      String?
  paymentMethod   String?   // cash, credit, debit, etransfer, cheque
  isReconciled    Boolean   @default(false)
  ocrRawData      Json?     // raw OCR extraction for debugging
  createdBy       Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([adminId, date])
  @@index([adminId, category])
}

// ═══════════════════════════════════════════════════════════════
// BOOKKEEPING — Revenue (tenant-scoped)
// ═══════════════════════════════════════════════════════════════

model BkRevenue {
  id              Int       @id @default(autoincrement())
  adminId         Int?
  admin           User?     @relation("TenantBkRevenues", fields: [adminId], references: [id])
  source          String    @default("manual") // manual, commission, listing, referral
  listingId       Int?
  date            DateTime
  amount          Float
  category        String    @default("commission")
  description     String?
  clientName      String?
  invoiceNumber   String?
  isReconciled    Boolean   @default(false)
  createdBy       Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([adminId, date])
  @@index([adminId, category])
}

// ═══════════════════════════════════════════════════════════════
// BOOKKEEPING — Payroll Employees (tenant-scoped)
// ═══════════════════════════════════════════════════════════════

model BkEmployee {
  id              Int       @id @default(autoincrement())
  adminId         Int?
  admin           User?     @relation("TenantBkEmployees", fields: [adminId], references: [id])
  name            String
  email           String?
  role            String?
  salaryType      String    @default("hourly") // hourly, fixed
  hourlyRate      Float?
  fixedSalary     Float?
  province        String    @default("AB")
  startDate       DateTime  @default(now())
  isActive        Boolean   @default(true)
  isSelf          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  payments        BkPayrollPayment[]

  @@index([adminId, isActive])
}

// ═══════════════════════════════════════════════════════════════
// BOOKKEEPING — Payroll Payments (tenant-scoped)
// ═══════════════════════════════════════════════════════════════

model BkPayrollPayment {
  id                  Int       @id @default(autoincrement())
  adminId             Int?
  admin               User?     @relation("TenantBkPayrollPayments", fields: [adminId], references: [id])
  employeeId          Int
  employee            BkEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payDate             DateTime
  periodStart         DateTime?
  periodEnd           DateTime?
  hoursWorked         Float?
  grossAmount         Float
  cppDeduction        Float     @default(0)
  eiDeduction         Float     @default(0)
  incomeTaxDeduction  Float     @default(0)
  otherDeductions     Float     @default(0)
  netAmount           Float
  notes               String?
  createdAt           DateTime  @default(now())

  @@index([adminId, payDate])
  @@index([employeeId])
}
