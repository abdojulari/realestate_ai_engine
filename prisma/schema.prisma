generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
// USER & AUTH
// ═══════════════════════════════════════════════════════════════

model User {
  id                   Int       @id @default(autoincrement())
  email                String    @unique
  password             String?
  firstName            String
  lastName             String
  phone                String?
  preferredContactTime String?
  role                 String    @default("user") // super_admin, admin, user
  provider             String?
  providerId           String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  consentDate          DateTime?
  consentIpAddress     String?
  marketingConsent     Boolean   @default(false)
  avatar               String?
  bio                  String?
  emailNotifications   Boolean   @default(true)
  language             String?   @default("English")
  lastLoginAt          DateTime?
  loginCount           Int       @default(0)
  pushNotifications    Boolean   @default(true)
  smsNotifications     Boolean   @default(false)
  timezone             String?   @default("America/New_York")
  twoFactorCode        String?
  twoFactorCodeExpiry  DateTime?
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?

  // Password reset (forgot-password flow). Token is sha256 of the random secret emailed to the user.
  passwordResetToken       String?   @unique
  passwordResetTokenExpiry DateTime?

  // First-login security: force password change after provisioning
  mustChangePassword Boolean @default(false)

  // Subscription tier for admins (basic, silver, gold, platinum)
  subscriptionTier String?

  // When set on a team member (role user), grants scoped /admin API + UI access for the delegator's tenant.
  // Shape: { "crm": { "read": true, "write": false, "edit": false, "delete": false }, ... }
  delegatedAdminPermissions Json?

  // Users under the same tenant this delegated assistant must not see (e.g. high-profile clients).
  delegationExcludedUserIds Int[] @default([])

  // ── InstaConnect (digital business card / PWA) ──
  // Public handle used in the shareable URL: /connect/{instaConnectSlug}
  instaConnectSlug     String?               @unique
  instaConnectEnabled  Boolean               @default(true)
  // Optional per-agent overrides: { headline, company, primaryColor, coverImage, socialLinks: [{icon,name,url}] }
  instaConnectBranding Json?
  instaConnectCaptures InstaConnectCapture[] @relation("AdminInstaConnectCaptures")

  // Admin relationship – users belong to an admin (tenant)
  adminId Int?
  admin   User?  @relation("AdminUsers", fields: [adminId], references: [id])
  users   User[] @relation("AdminUsers")

  // ── Personal-data relations (userId / authorId) ──
  activityLogs    ActivityLog[]
  documents       Document[]
  homeEstimates   HomeEstimate[]    @relation("UserEstimates")
  properties      Property[]        @relation("UserProperties")
  propertyAlerts  PropertyAlert[]
  inquiries       PropertyInquiry[] @relation("UserInquiries")
  propertyViews   PropertyView[]
  savedProperties SavedProperty[]
  savedSearches   SavedSearch[]
  signatures      Signature[]
  viewingRequests ViewingRequest[]
  blogPosts       BlogPost[]        @relation("AuthorPosts")

  // ── Tenant-owned data relations (adminId) ──
  // Records belonging to this admin's tenant
  tenantProperties     Property[]             @relation("TenantProperties")
  tenantContentBlocks  ContentBlock[]
  tenantSettingsRows   Setting[]              @relation("TenantSettingRows")
  tenantEmailTemplates EmailTemplate[]
  tenantTestimonials   Testimonial[]
  tenantSubscribers    NewsletterSubscriber[]
  tenantNewsTemplates  NewsletterTemplate[]
  tenantNewsletters    Newsletter[]
  tenantAutomations    NewsletterAutomation[]
  tenantBlogCategories BlogCategory[]
  tenantBlogTags       BlogTag[]
  tenantBlogPosts      BlogPost[]             @relation("TenantPosts")
  tenantChatLeads      ChatLead[]
  tenantEstimates      HomeEstimate[]         @relation("TenantEstimates")
  tenantInquiries      PropertyInquiry[]      @relation("TenantInquiries")
  tenantSiteSettings   TenantSettings?

  // ── New feature relations (tenant-scoped) ──
  tenantListingTemplates    ListingTemplate[]    @relation("TenantListingTemplates")
  tenantCrmClients          CrmClient[]          @relation("TenantCrmClients")
  tenantCrmTransactions     CrmTransaction[]     @relation("TenantCrmTransactions")
  tenantCelebrationSettings CelebrationSettings? @relation("TenantCelebrationSettings")
  tenantCelebrationLogs     CelebrationLog[]     @relation("TenantCelebrationLogs")
  tenantCalendarEvents      CalendarEvent[]      @relation("TenantCalendarEvents")
  tenantBookingSlots        BookingSlot[]        @relation("TenantBookingSlots")
  tenantBookings            Booking[]            @relation("TenantBookings")
  tenantFacebookIntegration FacebookIntegration? @relation("TenantFacebookIntegration")
  tenantFacebookPosts       FacebookPost[]       @relation("TenantFacebookPosts")
  tenantPriceCutSearches    PriceCutSearch[]     @relation("TenantPriceCutSearches")
  tenantLeadForms           LeadForm[]           @relation("TenantLeadForms")
  tenantMarketingResources  MarketingResource[]  @relation("TenantMarketingResources")
  tenantWorkspaceTools      WorkspaceTool[]      @relation("TenantWorkspaceTools")
  tenantFlashNews           FlashNews[]          @relation("TenantFlashNews")

  // ── Bookkeeping relations (tenant-scoped) ──
  tenantBkExpenses        BkExpense[]        @relation("TenantBkExpenses")
  tenantBkRevenues        BkRevenue[]        @relation("TenantBkRevenues")
  tenantBkEmployees       BkEmployee[]       @relation("TenantBkEmployees")
  tenantBkPayrollPayments BkPayrollPayment[] @relation("TenantBkPayrollPayments")

  @@index([adminId])
}

// ═══════════════════════════════════════════════════════════════
// TENANT SETTINGS – per-admin branding, contact, social, etc.
// ═══════════════════════════════════════════════════════════════

model TenantSettings {
  id      Int  @id @default(autoincrement())
  adminId Int  @unique
  admin   User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  // Branding
  businessName String? // "DeelBot"
  tagline      String? // Displayed under logo
  logoUrl      String?
  faviconUrl   String?
  primaryColor String? @default("#1976D2")

  // Contact
  phone      String?
  email      String?
  address    String?
  city       String?
  province   String?
  postalCode String?

  // Social links  [{icon,name,url}]
  socialLinks Json?

  // Brokerage
  brokerageName    String?
  brokerageLogoUrl String?

  // External review links
  googleReviewUrl String?

  // Footer / legal
  footerDisclaimer String? @db.Text
  copyrightName    String?
  developerName    String?
  developerUrl     String?

  // Domain mapping (multi-tenant routing)
  subdomain    String? @unique // acme → acme.realestatehub.ca
  customDomain String? @unique // acmesrealty.com

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════
// PROPERTY & NEIGHBOURHOOD (tenant-scoped)
// ═══════════════════════════════════════════════════════════════

model Property {
  id                     Int                    @id @default(autoincrement())
  adminId                Int?
  admin                  User?                  @relation("TenantProperties", fields: [adminId], references: [id])
  title                  String
  description            String
  price                  Float
  beds                   Int
  baths                  Float
  sqft                   Float
  type                   String
  status                 String
  address                String
  city                   String
  province               String
  postalCode             String
  latitude               Float?
  longitude              Float?
  features               Json?
  images                 Json
  userId                 Int?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  views                  Int                    @default(0)
  cityRegion             String?
  externalId             String?
  lastSyncAt             DateTime?
  lotSizeArea            Float?
  lotSizeDimensions      String?
  lotSizeUnits           String?
  mlsNumber              String?
  parcelNumber           String?
  propertyCondition      String?
  source                 String                 @default("manual")
  stories                Int?
  streetName             String?
  streetNumber           String?
  taxAnnualAmount        Float?
  taxYear                Int?
  unitNumber             String?
  waterBodyName          String?
  yearBuilt              Int?
  zoning                 String?
  zoningDescription      String?
  coListingAgentsData    Json?
  coListingOfficesData   Json?
  listingAgentData       Json?
  listingOfficeData      Json?
  daysOnMarket           Int?
  originalEntryTimestamp DateTime?
  firstEntryPrice        Float? // Price when first synced – never updated after creation
  // True original/previous list prices straight from the MLS feed (RESO standard).
  // These let the "Best Deals" page detect reductions that happened BEFORE we
  // first ingested a listing — `firstEntryPrice` only captures changes that
  // occurred after the property was already in our DB.
  originalListPrice      Float? // MLS OriginalListPrice — the very first asking price
  previousListPrice      Float? // MLS PreviousListPrice — the asking price before the most recent change
  priceChangeTimestamp   DateTime? // MLS PriceChangeTimestamp / MajorChangeTimestamp for the most recent price move
  user                   User?                  @relation("UserProperties", fields: [userId], references: [id])
  inquiries              PropertyInquiry[]
  neighborhood           PropertyNeighborhood?
  propertyViews          PropertyView[]
  savedBy                SavedProperty[]
  viewingRequests        ViewingRequest[]
  priceHistory           PropertyPriceHistory[]

  @@unique([source, externalId])
  @@index([adminId])
}

// Neighbourhood = shared geographic reference data (global)
model Neighborhood {
  id               Int                    @id @default(autoincrement())
  name             String
  city             String
  province         String
  country          String                 @default("Canada")
  centerLatitude   Float?
  centerLongitude  Float?
  boundingBox      Json?
  formattedAddress String?
  confidence       Int?
  components       Json?
  propertyCount    Int                    @default(0)
  averagePrice     Float?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  properties       PropertyNeighborhood[]

  @@unique([name, city, province])
  @@index([city, province])
}

model PropertyNeighborhood {
  id             Int          @id @default(autoincrement())
  propertyId     Int          @unique
  neighborhoodId Int
  confidence     Int?
  lastLookup     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  neighborhood   Neighborhood @relation(fields: [neighborhoodId], references: [id])
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([neighborhoodId])
}

// ═══════════════════════════════════════════════════════════════
// CONTENT & SETTINGS (tenant-scoped)
// ═══════════════════════════════════════════════════════════════

model ContentBlock {
  id        Int      @id @default(autoincrement())
  adminId   Int?
  admin     User?    @relation(fields: [adminId], references: [id])
  key       String
  title     String
  content   String
  type      String
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminId, key])
  @@index([adminId])
}

model Setting {
  id        Int      @id @default(autoincrement())
  adminId   Int?
  admin     User?    @relation("TenantSettingRows", fields: [adminId], references: [id])
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminId, key])
  @@index([adminId])
}

// ═══════════════════════════════════════════════════════════════
// USER-SCOPED (personal data – userId only)
// ═══════════════════════════════════════════════════════════════

model SavedSearch {
  id        Int      @id @default(autoincrement())
  userId    Int
  filters   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model PropertyAlert {
  id               Int       @id @default(autoincrement())
  userId           Int
  naturalQuery     String
  parsedFilters    Json
  city             String?
  frequency        String
  isActive         Boolean   @default(true)
  lastRun          DateTime?
  nextRun          DateTime?
  emailEnabled     Boolean   @default(true)
  pushEnabled      Boolean   @default(false)
  marketingConsent Boolean   @default(false)
  consentDate      DateTime?
  lastResults      Json?
  totalSent        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id])
}

model ViewingRequest {
  id         Int      @id @default(autoincrement())
  userId     Int
  propertyId Int
  dateTime   DateTime
  status     String
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  property   Property @relation(fields: [propertyId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
}

model SavedProperty {
  id         Int      @id @default(autoincrement())
  userId     Int
  propertyId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  property   Property @relation(fields: [propertyId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, propertyId])
}

model PropertyView {
  id         Int      @id @default(autoincrement())
  userId     Int?
  propertyId Int
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])
}

// ═══════════════════════════════════════════════════════════════
// EMAIL & TEMPLATES (tenant-scoped)
// ═══════════════════════════════════════════════════════════════

model EmailTemplate {
  id        Int      @id @default(autoincrement())
  adminId   Int?
  admin     User?    @relation(fields: [adminId], references: [id])
  name      String
  subject   String
  content   String
  variables Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminId, name])
  @@index([adminId])
}

// ═══════════════════════════════════════════════════════════════
// CRM – LEADS, INQUIRIES, ESTIMATES (tenant-scoped)
// ═══════════════════════════════════════════════════════════════

model PropertyInquiry {
  id         Int      @id @default(autoincrement())
  adminId    Int?
  admin      User?    @relation("TenantInquiries", fields: [adminId], references: [id])
  userId     Int?
  propertyId Int
  message    String
  status     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  property   Property @relation(fields: [propertyId], references: [id])
  user       User?    @relation("UserInquiries", fields: [userId], references: [id])

  @@index([adminId])
}

model HomeEstimate {
  id                Int      @id @default(autoincrement())
  adminId           Int?
  admin             User?    @relation("TenantEstimates", fields: [adminId], references: [id])
  userId            Int?
  address           String
  postalCode        String
  propertyType      String
  beds              Int
  baths             Float
  sqft              Float
  yearBuilt         Int
  lotSize           String
  condition         String
  features          Json?
  renovations       Json?
  additionalInfo    String?
  firstName         String
  lastName          String
  email             String
  phone             String
  timeframe         String
  contactPreference Boolean  @default(false)
  status            String   @default("pending")
  estimatedValue    Float?
  agentNotes        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User?    @relation("UserEstimates", fields: [userId], references: [id])

  @@index([adminId])
}

model Testimonial {
  id           Int      @id @default(autoincrement())
  adminId      Int?
  admin        User?    @relation(fields: [adminId], references: [id])
  name         String
  email        String
  phone        String?
  location     String
  content      String
  rating       Int      @default(5)
  propertyType String?
  avatar       String?
  approved     Boolean  @default(false)
  featured     Boolean  @default(false)
  displayOrder Int?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([adminId, approved, featured, displayOrder])
  @@index([createdAt])
}

model ChatLead {
  id              Int      @id @default(autoincrement())
  adminId         Int?
  admin           User?    @relation(fields: [adminId], references: [id])
  name            String
  email           String
  phone           String?
  message         String?
  conversationLog Json?
  source          String   @default("chat_widget")
  status          String   @default("new")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([adminId, email])
  @@index([adminId, status])
}

// ═══════════════════════════════════════════════════════════════
// INSTACONNECT — captures from QR-scanned digital business card
// (Staging area for inbound contacts before they are promoted to CRM.)
// ═══════════════════════════════════════════════════════════════

model InstaConnectCapture {
  id      Int  @id @default(autoincrement())
  adminId Int
  admin   User @relation("AdminInstaConnectCaptures", fields: [adminId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  email     String
  phone     String
  company   String?
  interest  String? // buying | selling | renting | connecting
  message   String? @db.Text
  consent   Boolean @default(false)

  // pending → accepted (promoted to CRM) | rejected
  status      String @default("pending")
  // crmClient row created when status flips to accepted
  crmClientId Int?

  // Lightweight provenance
  userAgent String?
  ipHash    String?
  referrer  String?

  createdAt  DateTime  @default(now())
  acceptedAt DateTime?
  rejectedAt DateTime?

  @@index([adminId, status, createdAt])
  @@index([adminId, email])
}

// ═══════════════════════════════════════════════════════════════
// ACTIVITY LOG (user-scoped)
// ═══════════════════════════════════════════════════════════════

model ActivityLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  action      String
  entity      String?
  entityId    Int?
  description String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([action])
  @@index([entity, entityId])
}

// ═══════════════════════════════════════════════════════════════
// DOCUMENTS & SIGNATURES (user-scoped)
// ═══════════════════════════════════════════════════════════════

model Document {
  id               Int                  @id @default(autoincrement())
  userId           Int
  name             String
  originalName     String
  type             String
  fileSize         Int
  filePath         String
  status           String               @default("draft")
  isSigned         Boolean              @default(false)
  signatureData    Json?
  watermarkApplied Boolean              @default(false)
  metadata         Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalReview      DocumentLegalReview?
  dateAlerts       DocumentDateAlert[]

  @@index([userId, createdAt])
  @@index([status])
}

model DocumentLegalReview {
  id                Int      @id @default(autoincrement())
  documentId        Int      @unique
  redFlags          Json
  importantNotes    Json
  importantDates    Json
  legalSummary      String   @db.Text
  buyerImpact       String   @db.Text
  sellerImpact      String   @db.Text
  partyRepresenting String?
  reviewedAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model DocumentDateAlert {
  id         Int       @id @default(autoincrement())
  documentId Int
  label      String
  dueDate    DateTime
  daysBefore Int       @default(2)
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
  document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([dueDate, sentAt])
}

model Signature {
  id            Int      @id @default(autoincrement())
  userId        Int
  name          String
  type          String
  signatureData String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════
// NEWSLETTER (tenant-scoped)
// ═══════════════════════════════════════════════════════════════

model NewsletterSubscriber {
  id              Int              @id @default(autoincrement())
  adminId         Int?
  admin           User?            @relation(fields: [adminId], references: [id])
  email           String
  firstName       String?
  lastName        String?
  status          String           @default("active")
  source          String           @default("website")
  tags            Json?
  metadata        Json?
  subscribedAt    DateTime         @default(now())
  unsubscribedAt  DateTime?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sentNewsletters SentNewsletter[]

  @@unique([adminId, email])
  @@index([adminId, status, subscribedAt])
}

model NewsletterTemplate {
  id               Int          @id @default(autoincrement())
  adminId          Int?
  admin            User?        @relation(fields: [adminId], references: [id])
  name             String
  subject          String
  content          String
  plainTextContent String?
  previewText      String?
  category         String?
  tags             Json?
  isActive         Boolean      @default(true)
  attachments      Json?
  variables        Json?
  designSettings   Json?
  createdBy        Int?
  lastModifiedBy   Int?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  newsletters      Newsletter[]

  @@unique([adminId, name])
  @@index([adminId, category, isActive])
}

model Newsletter {
  id                 Int                 @id @default(autoincrement())
  adminId            Int?
  admin              User?               @relation(fields: [adminId], references: [id])
  name               String
  templateId         Int?
  subject            String
  content            String
  plainTextContent   String?
  previewText        String?
  status             String              @default("draft")
  frequency          String?
  scheduledFor       DateTime?
  sentAt             DateTime?
  recipientCount     Int                 @default(0)
  openCount          Int                 @default(0)
  clickCount         Int                 @default(0)
  bounceCount        Int                 @default(0)
  unsubscribeCount   Int                 @default(0)
  attachments        Json?
  tags               Json?
  targetFilters      Json?
  abTestConfig       Json?
  automationSettings Json?
  createdBy          Int?
  lastModifiedBy     Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  template           NewsletterTemplate? @relation(fields: [templateId], references: [id])
  sentNewsletters    SentNewsletter[]

  @@index([adminId, status, scheduledFor])
  @@index([adminId, frequency, status])
  @@index([createdAt])
}

model SentNewsletter {
  id             Int                  @id @default(autoincrement())
  newsletterId   Int
  subscriberId   Int
  status         String               @default("sent")
  sentAt         DateTime             @default(now())
  openedAt       DateTime?
  clickedAt      DateTime?
  bouncedAt      DateTime?
  bounceReason   String?
  unsubscribedAt DateTime?
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  newsletter     Newsletter           @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  subscriber     NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([newsletterId, status])
  @@index([subscriberId])
  @@index([sentAt])
}

model NewsletterAutomation {
  id            Int       @id @default(autoincrement())
  adminId       Int?
  admin         User?     @relation(fields: [adminId], references: [id])
  name          String
  description   String?
  triggerType   String
  frequency     String?
  dayOfWeek     Int?
  dayOfMonth    Int?
  timeOfDay     String?
  timezone      String    @default("America/New_York")
  templateId    Int?
  subject       String?
  targetFilters Json?
  isActive      Boolean   @default(true)
  lastRun       DateTime?
  nextRun       DateTime?
  runCount      Int       @default(0)
  createdBy     Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([adminId, isActive, nextRun])
  @@index([triggerType, frequency])
}

// ═══════════════════════════════════════════════════════════════
// BLOG (tenant-scoped)
// ═══════════════════════════════════════════════════════════════

model BlogCategory {
  id          Int            @id @default(autoincrement())
  adminId     Int?
  admin       User?          @relation(fields: [adminId], references: [id])
  name        String
  slug        String
  description String?
  color       String?        @default("#1976D2")
  icon        String?        @default("mdi-folder")
  parentId    Int?
  sortOrder   Int            @default(0)
  isActive    Boolean        @default(true)
  postCount   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  parent      BlogCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    BlogCategory[] @relation("CategoryHierarchy")
  posts       BlogPost[]

  @@unique([adminId, name])
  @@unique([adminId, slug])
  @@index([adminId, isActive, sortOrder])
}

model BlogPost {
