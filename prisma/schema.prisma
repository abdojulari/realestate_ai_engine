// ═══════════════════════════════════════════════════════════════
// CRM – CLIENTS & TRANSACTIONS (tenant-scoped)
// ═══════════════════════════════════════════════════════════════

model CrmClient {
  id                    Int              @id @default(autoincrement())
  adminId               Int?
  admin                 User?            @relation("TenantCrmClients", fields: [adminId], references: [id])
  firstName             String
  lastName              String
  email                 String?
  phone                 String?
  type                  String // buyer, seller, investor, lead
  status                String           @default("active") // active, inactive, closed
  source                String? // inquiry, chat, estimate, referral, manual
  sourceId              Int? // link to original lead record
  notes                 String?          @db.Text
  tags                  Json?
  metadata              Json?
  // ── Celebration / anniversary tracking ──
  // Stored as DateTime for portability; only month/day are used for fixed-anniversary matching.
  dateOfBirth           DateTime?
  weddingAnniversary    DateTime?
  // Successful closing anniversary. Mirrored from the latest closed CrmTransaction.closingDate
  // when set, so we don't have to JOIN on every cron run.
  closingAnniversary    DateTime?
  // Holiday opt-outs. Keys: "christmas", "new_year", "eid", and any future ones.
  // Stored as String[] (Postgres array) so we can do `has`/`hasSome` queries cheaply.
  holidayExceptions     String[]         @default([])
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  transactions          CrmTransaction[]
  celebrationLogs       CelebrationLog[]

  @@unique([adminId, email])
  @@index([adminId, type, status])
}

model CrmTransaction {
  id              Int                @id @default(autoincrement())
  adminId         Int?
  admin           User?              @relation("TenantCrmTransactions", fields: [adminId], references: [id])
  clientId        Int
  client          CrmClient          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  propertyId      Int?
  type            String // buying, selling
  status          String             @default("active") // active, conditional, firm, closed, cancelled
  propertyAddress String?
  salePrice       Float?
  closingDate     DateTime?
  possessionDate  DateTime?
  notes           String?            @db.Text
  progress        Float              @default(0) // 0-100 percentage
  currentStage    String?
  metadata        Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  checklist       CrmChecklistItem[]

  @@index([adminId, status])
  @@index([clientId])
}

model CrmChecklistItem {
  id            Int            @id @default(autoincrement())
  transactionId Int
  transaction   CrmTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  label         String
  description   String?
  isCompleted   Boolean        @default(false)
  completedAt   DateTime?
  completedBy   Int?
  sortOrder     Int            @default(0)
  dueDate       DateTime?
  isRequired    Boolean        @default(true)
  category      String? // pre-approval, showing, offer, conditions, closing
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([transactionId, sortOrder])
}

// Per-tenant configuration for celebration emails.
// One row per admin (tenant). Created lazily on first GET if missing.
model CelebrationSettings {
  id                  Int      @id @default(autoincrement())
  adminId             Int      @unique
  admin               User     @relation("TenantCelebrationSettings", fields: [adminId], references: [id], onDelete: Cascade)
  // Auto-send toggles (per kind). When false, the cron only surfaces the celebration
  // as a notification on the CRM and the admin sends manually.
  autoSendBirthday    Boolean  @default(false)
  autoSendAnniversary Boolean  @default(false)
  autoSendClosing     Boolean  @default(false)
  autoSendChristmas   Boolean  @default(false)
  autoSendNewYear     Boolean  @default(false)
  // Templates. Body uses {{firstName}} / {{lastName}} / {{adminName}} placeholders.
  birthdayTemplate    String?  @db.Text
  anniversaryTemplate String?  @db.Text
  closingTemplate     String?  @db.Text
  christmasTemplate   String?  @db.Text
  newYearTemplate     String?  @db.Text
  eidTemplate         String?  @db.Text
  birthdaySubject     String?
  anniversarySubject  String?
  closingSubject      String?
  christmasSubject    String?
  newYearSubject      String?
  eidSubject          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// Audit trail for celebration messages. Also used to dedupe (avoid sending the same
// kind to the same client twice in the same calendar day).
model CelebrationLog {
  id        Int       @id @default(autoincrement())
  adminId   Int
  admin     User      @relation("TenantCelebrationLogs", fields: [adminId], references: [id], onDelete: Cascade)
  clientId  Int
  client    CrmClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // birthday | anniversary | closing | christmas | new_year | eid | custom
  kind      String
  subject   String
  body      String    @db.Text
  // auto = sent by cron with template; manual = admin clicked Send Wishes
  mode      String    @default("manual")
  // ok | failed | skipped
  status    String    @default("ok")
  error     String?
  sentAt    DateTime  @default(now())

  @@index([adminId, kind, sentAt])
  @@index([clientId, kind, sentAt])
}

// ═══════════════════════════════════════════════════════════════
// CALENDAR & BOOKING (tenant-scoped)
// ═══════════════════════════════════════════════════════════════

model CalendarEvent {
  id          Int       @id @default(autoincrement())
  adminId     Int?
  admin       User?     @relation("TenantCalendarEvents", fields: [adminId], references: [id])
  title       String
  description String?   @db.Text
  type        String // task, meeting, showing, open_house, reminder, personal
  startTime   DateTime
  endTime     DateTime?
  allDay      Boolean   @default(false)
  location    String?
  color       String?
  status      String    @default("scheduled") // scheduled, completed, cancelled
  priority    String?   @default("normal") // low, normal, high, urgent
  reminders   Json? // [{type: 'email'|'push', minutesBefore: 30}]
  recurrence  Json? // {frequency, interval, endDate}
  propertyId  Int?
  clientId    Int?
  isPublic    Boolean   @default(false)
  metadata    Json?
  createdBy   Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([adminId, startTime, endTime])
  @@index([adminId, type, status])
}

model BookingSlot {
  id           Int       @id @default(autoincrement())
  adminId      Int?
  admin        User?     @relation("TenantBookingSlots", fields: [adminId], references: [id])
  dayOfWeek    Int? // 0-6 (Sun-Sat), null for specific dates
  specificDate DateTime? // for one-off slots
  startTime    String // HH:mm format
  endTime      String // HH:mm format
  duration     Int       @default(30) // minutes per booking
  maxBookings  Int       @default(1)
  isActive     Boolean   @default(true)
  propertyId   Int? // if slot is property-specific
  label        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([adminId, dayOfWeek, isActive])
  @@index([adminId, specificDate])
}

model Booking {
  id               Int       @id @default(autoincrement())
  adminId          Int?
  admin            User?     @relation("TenantBookings", fields: [adminId], references: [id])
  slotId           Int?
  clientName       String
  clientEmail      String
  clientPhone      String?
  propertyId       Int?
  dateTime         DateTime
  endTime          DateTime?
  duration         Int       @default(30)
  status           String    @default("confirmed") // confirmed, cancelled, completed, no_show
  type             String    @default("showing") // showing, consultation, open_house
  notes            String?   @db.Text
  confirmationSent Boolean   @default(false)
  reminderSent     Boolean   @default(false)
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([adminId, dateTime])
  @@index([adminId, status])
  @@index([clientEmail])
}

