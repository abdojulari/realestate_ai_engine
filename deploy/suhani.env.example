# =============================================================================
# Suhani (tenant MLS app) — *.deelbot.ai
# =============================================================================

# JWT
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING

# OAuth (Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth (Facebook login)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Multi-tenant OAuth canonical callback (REQUIRED for *.deelbot.ai SaaS).
# When set, every Google login (no matter which tenant subdomain the user
# starts on) routes through `<canonical>/api/auth/google/callback`. Result:
# you only register ONE redirect URI in Google Cloud Console and unlimited
# tenant subdomains work automatically — no console edits when onboarding
# a new realtor. The originating subdomain is HMAC-signed into the OAuth
# state and validated against OAUTH_ALLOWED_HOST_SUFFIX before the JWT is
# bounced back to it.
# Leave both blank to use the legacy per-host flow (one redirect URI per
# subdomain, manual Google Cloud Console maintenance).
OAUTH_CANONICAL_HOST=https://deelbot.ai
OAUTH_ALLOWED_HOST_SUFFIX=deelbot.ai

# CREA / MLS data feed
CREA_CLIENT_ID=
CREA_CLIENT_SECRET=

# Nuxt public URLs
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: leave both BLANK in any multi-tenant deployment.
#
# This is a shared Nuxt build that is served to every tenant subdomain
# (aohomes.deelbot.ai, tonahomes.deelbot.ai, …). Whatever you set here is
# baked into the SSR HTML and the client JS bundle that all tenants download.
#
#   • NUXT_PUBLIC_API_BASE — defaults to "/api" (relative). If you set it to
#     an absolute URL like https://aohomes.deelbot.ai/api, EVERY tenant's
#     browser will try to call that hostname → CORS-blocked cross-origin
#     requests on every other tenant's site (see incident: tonahomes calling
#     aohomes/api/admin/flash-news).
#
#   • NUXT_PUBLIC_SITE_URL — used for canonical URLs, OpenGraph tags, and
#     JSON-LD. The app derives it per-request from the Host header (SSR) and
#     window.location (client), so the right value is automatic. Setting an
#     absolute URL here forces every tenant's <link rel=canonical>, sitemap,
#     and og:url to point at that one host, which is wrong for SEO.
#
# Only set these if you are running a SINGLE-tenant deployment with one
# fixed hostname. For *.deelbot.ai keep them empty.
NUXT_PUBLIC_API_BASE=
NUXT_PUBLIC_SITE_URL=

# Control plane connection (for license checks)
CONTROL_PLANE_URL=http://control-plane:3001
CONTROL_PLANE_API_KEY=CHANGE_ME_SHARED_API_KEY

# SMTP (transactional email)
SMTP_HOSTNAME=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=noreply@deelbot.ai

# Agent email (contact form recipient)
AGENT_EMAIL=

# =============================================================================
# AI providers — used by chat, search, and the compliance-review pipeline
# =============================================================================
# The compliance-review pipeline (server/utils/llm.ts) tries these in a
# failover chain. Any one of them is enough to keep the feature working;
# configuring all three gives the most headroom on free-tier daily quotas.
#
# Recommended for production: configure at minimum Groq + Cerebras so the
# pipeline survives any single-provider rate-limit storm.

# Groq — fastest, generous TPD, free at https://console.groq.com
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1

# Cerebras — second-fastest, 1M tokens/day on free tier.
# IMPORTANT: host is api.cerebras.AI (not .com). Sign up at https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_API_URL=https://api.cerebras.ai/v1

# OpenRouter — overflow / last-resort fallback. Free tier is 50 req/day
# (1,000/day with any purchased credits). Sign up at https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1
# Optional — sent as HTTP-Referer for OpenRouter analytics attribution.
# Pick any one of your tenant hostnames; this is for OpenRouter's dashboard
# only and never reaches end users, so a single value is fine.
OPENROUTER_REFERER=https://app.deelbot.ai

# Geocoding
OPENCAGE_API_KEY=
