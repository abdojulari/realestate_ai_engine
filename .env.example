# =============================================================================
# Suhani (tenant MLS app) — copy to .env and/or .env.production for Docker Compose
# =============================================================================
# Tenant URLs use APP_BASE_DOMAIN (e.g. subdomain.deelbot.ai). Custom domains need
# nginx + TLS; see nginx/conf.d/custom-domains.conf.example

NODE_ENV=production

# When you run `docker compose --env-file .env.production ...` by hand, export this so the app container loads the same file (not a stale .env):
#   export SUHANI_ENV_FILE=.env.production
# `./scripts/deploy.sh standalone` sets it automatically.
# On a server, if both `.env` and `.env.production` exist, deploy uses **.env.production first** (same for `verify-db`).

# PostgreSQL — for **host** tools (`npm run dev`, `npx prisma` on your machine) use localhost + published port:
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/real_estate?schema=public
# Docker app container DATABASE_URL is built from POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB @ host `db` (must match the db service).
# Override with: SUHANI_DOCKER_DATABASE_URL=postgresql://user:pass@db:5432/real_estate?schema=public
#
# If `prisma db seed` / P1000 says credentials are invalid: (1) Comment out SUHANI_DOCKER_DATABASE_URL unless it matches POSTGRES_*.
# (2) Postgres only reads POSTGRES_PASSWORD on first init; changing .env does not change an existing volume — use the original password,
#     or `docker compose down -v` (wipes DB) and redeploy. (3) URL-encode @ : / # ? in passwords or use SUHANI_DOCKER_DATABASE_URL.
# (4) The official Postgres Docker image uses trust for 127.0.0.1 — psql inside db on localhost does NOT prove the password is correct;
#     Prisma from the app container uses SCRAM. Use deploy.sh checks / `prisma db execute` from app, not psql-on-localhost alone.
# (5) Do not define POSTGRES_* (or DATABASE_URL) twice in the same file — Docker Compose uses the last; deploy.sh now matches that.
# `scripts/deploy.sh standalone` syncs the Postgres role password to POSTGRES_PASSWORD in this file each run (ALTER via local trust).
# To skip that (e.g. you manage passwords only by hand): SUHANI_SKIP_SYNC_DB_PASSWORD=1
# docker-compose.prod.yml maps host port 5435 (SUHANI_POSTGRES_PUBLISH_PORT).

# Redis — REQUIRED in production. The compose stacks now run redis-server with --requirepass and bind 6379/6381 to 127.0.0.1 only.
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM_REDIS_PASSWORD
# Host dev (npm run dev on the laptop): connect to the loopback-published port using the same password.
# In docker, the app builds redis://:${REDIS_PASSWORD}@redis:6379 from REDIS_PASSWORD automatically — set SUHANI_DOCKER_REDIS_URL only to point at an external Redis.
REDIS_URL=redis://:CHANGE_ME_LONG_RANDOM_REDIS_PASSWORD@localhost:6379

JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Published nginx ports (defaults 9080/9443 — no clash with saas-control-plane on 9081/9444). Use 80/443 when this stack owns them.
# NGINX_PUBLISH_HTTP_PORT=9080
# NGINX_PUBLISH_HTTPS_PORT=9443
# Docker app publish (host:container or ip:host:container). Host Nginx edge: SUHANI_APP_PORTS=127.0.0.1:3000:3000
# SUHANI_APP_PORTS=3000:3000

# Public URLs (browser + OAuth callbacks).
# ─────────────────────────────────────────────────────────────────────────────
# MULTI-TENANT (production *.deelbot.ai): leave both BLANK. The shared Nuxt
# build is served to every tenant subdomain — any absolute URL set here would
# be baked into the client bundle and force EVERY tenant to call that one
# host (CORS-blocked) or render that one host in canonical/og:url tags.
# Defaults: NUXT_PUBLIC_API_BASE → "/api" (same-origin), NUXT_PUBLIC_SITE_URL
# is derived per-request from the Host header (SSR) and window.location
# (client). See deploy/suhani.env.example for the full explanation.
#
# SINGLE-TENANT or LOCAL DEV with one fixed hostname (e.g. https://localhost:9443):
# you may set them, but only if NO other tenant is served by the same build.
NUXT_PUBLIC_API_BASE=
NUXT_PUBLIC_SITE_URL=
APP_BASE_DOMAIN=deelbot.ai

# Control plane (server-side calls from the app container — use host.docker.internal when CP runs on same machine)
CONTROL_PLANE_URL=https://host.docker.internal:9444
CONTROL_PLANE_API_KEY=CHANGE_ME_SHARED_WITH_CONTROL_PLANE

# SMTP
SMTP_HOSTNAME=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=noreply@your-domain.com
AGENT_EMAIL=

# Cloudflare Turnstile (site key is public; secret must not use the NUXT_PUBLIC_ prefix in production — use NUXT_TURNSTILE_SECRET_KEY.)
NUXT_PUBLIC_SITE_KEY=
# Server-only Turnstile secret (preferred). Legacy: NUXT_PUBLIC_SECRET_KEY in .env is read by compose only to set NUXT_TURNSTILE_SECRET_KEY and is unset before Node starts.
NUXT_TURNSTILE_SECRET_KEY=

# AI providers — used by chat, search, and the compliance-review pipeline.
# The compliance pipeline tries them in a failover chain so any one of them
# is enough to keep the feature working; configuring all three gives you the
# most headroom on free-tier daily quotas.
#
# Groq — fastest, generous TPD, free tier at https://console.groq.com
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1

# Cerebras — second-fastest, 1M tokens/day on free tier.
# IMPORTANT: the host is api.cerebras.AI (not .com). Sign up at https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_API_URL=https://api.cerebras.ai/v1

# OpenRouter — overflow / last-resort fallback. Free tier is 50 req/day
# (1,000/day with any purchased credits). Sign up at https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1
# Optional — sent as the HTTP-Referer header so OpenRouter can attribute
# usage to your site in their analytics. Defaults to homebyabdul.com.
OPENROUTER_REFERER=

# Geocoding
OPENCAGE_API_KEY=

# Geoapify (nearby schools, parks, etc. on property detail — free tier at https://myprojects.geoapify.com)
GEOAPIFY_API_KEY=

# Verdocs e-sign
VERDOCS_CLIENT_ID=
VERDOCS_CLIENT_SECRET=
VERDOCS_API_BASE=https://api.verdocs.com

# Optional: CREA / Pillar9 cron scripts (scripts/*.mjs)
# NUXT_PUBLIC_SITE_URL or APP_URL is used as API base for sync scripts
# PILLAR9_SYNC_SECRET or CRON_SECRET for pillar9-sync.mjs

# Optional local deploy script
# SEED_DATABASE=true
# prisma/seed.ts upserts super_admin (defaults below; override for production)
# SUPER_ADMIN_EMAIL=abdulkabirojulari@gmail.com
# SUPER_ADMIN_PASSWORD=your-secure-password
# USE_SELF_SIGNED_SSL=1
