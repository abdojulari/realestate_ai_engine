# =============================================================================
# Suhani (tenant MLS app) — copy to .env and/or .env.production for Docker Compose
# =============================================================================
# Tenant URLs use APP_BASE_DOMAIN (e.g. subdomain.deelbot.ai). Custom domains need
# nginx + TLS; see nginx/conf.d/custom-domains.conf.example

NODE_ENV=production

# PostgreSQL — for **host** tools (`npm run dev`, `npx prisma` on your machine) use localhost + published port:
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/real_estate?schema=public
# Docker app container DATABASE_URL is built from POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB @ host `db` (must match the db service).
# Override with: SUHANI_DOCKER_DATABASE_URL=postgresql://user:pass@db:5432/real_estate?schema=public
# docker-compose.prod.yml maps host port 5435 (SUHANI_POSTGRES_PUBLISH_PORT).

# Redis — host dev: redis://localhost:6379 if you publish 6379. Docker app uses redis://redis:6379 unless you set SUHANI_DOCKER_REDIS_URL.
REDIS_URL=redis://localhost:6379

JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Published nginx ports (defaults 9080/9443 — no clash with saas-control-plane on 9081/9444). Use 80/443 when this stack owns them.
# NGINX_PUBLISH_HTTP_PORT=9080
# NGINX_PUBLISH_HTTPS_PORT=9443
# Docker app publish (host:container or ip:host:container). Host Nginx edge: SUHANI_APP_PORTS=127.0.0.1:3000:3000
# SUHANI_APP_PORTS=3000:3000

# Public URLs (browser + OAuth callbacks). With default ports use https://localhost:9443; in production use your real hostname.
NUXT_PUBLIC_API_BASE=https://localhost:9443/api
NUXT_PUBLIC_SITE_URL=https://localhost:9443
APP_BASE_DOMAIN=deelbot.ai

# Control plane (server-side calls from the app container — use host.docker.internal when CP runs on same machine)
CONTROL_PLANE_URL=https://host.docker.internal:9444
CONTROL_PLANE_API_KEY=CHANGE_ME_SHARED_WITH_CONTROL_PLANE

# SMTP
SMTP_HOSTNAME=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=noreply@your-domain.com
AGENT_EMAIL=

# Cloudflare Turnstile
NUXT_PUBLIC_SITE_KEY=
NUXT_PUBLIC_SECRET_KEY=

# Geocoding
OPENCAGE_API_KEY=

# Verdocs e-sign
VERDOCS_CLIENT_ID=
VERDOCS_CLIENT_SECRET=
VERDOCS_API_BASE=https://api.verdocs.com

# Optional: CREA / Pillar9 cron scripts (scripts/*.mjs)
# NUXT_PUBLIC_SITE_URL or APP_URL is used as API base for sync scripts
# PILLAR9_SYNC_SECRET or CRON_SECRET for pillar9-sync.mjs

# Optional local deploy script
# SEED_DATABASE=true
# prisma/seed.ts upserts super_admin (defaults below; override for production)
# SUPER_ADMIN_EMAIL=abdulkabirojulari@gmail.com
# SUPER_ADMIN_PASSWORD=your-secure-password
# USE_SELF_SIGNED_SSL=1
